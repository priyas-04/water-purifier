# AquaPure Marketing Automation Environment Variables

# --- General ---
TIMEZONE=Asia/Kolkata

# --- LLM API (Caption & Hashtag Generation) ---
# Supported providers: Gemini API, OpenAI, or Anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative: OPENAI_API_KEY=sk-...

# --- Image Generation API ---
# Supported providers: Hugging Face Inference API, Stability AI, or DALL-E
IMAGE_GEN_PROVIDER=huggingface
HUGGINGFACE_API_KEY=hf_your_api_token_here
HUGGINGFACE_MODEL=black-forest-labs/FLUX.1-schnell
# Alternative: OPENAI_IMAGE_API_KEY=sk-...

# --- Cloudinary (Public Image Hosting CDN) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Instagram Graph API (Official Meta Business) ---
# Requires Instagram Business or Creator Account connected to a Facebook Page
INSTAGRAM_BUSINESS_ACCOUNT_ID=17841400000000000
INSTAGRAM_PAGE_ACCESS_TOKEN=EAAB...your_long_lived_user_or_page_token...

# --- WAHA (WhatsApp HTTP API - Bonus Status Automation) ---
WAHA_BASE_URL=http://waha:3000
WAHA_SESSION_NAME=aquapure-marketing

# --- Firestore / Database Integration ---
FIREBASE_PROJECT_ID=aquapure-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@aquapure-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...==\n-----END PRIVATE KEY-----\n"
